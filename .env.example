# Copy to .env and fill in values as needed.
# See README.md "Auth" for details.

# GitHub fetch fallback + repo languages API (optional if local clone is available)
# GITHUB_TOKEN=

# LLM provider: cursor | openai | anthropic (default: cursor)
# STYLECT_LLM_PROVIDER=cursor

# Provider-specific API keys (use one matching STYLECT_LLM_PROVIDER)
# CURSOR_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Generic fallback when provider-specific key is not set
# STYLECT_LLM_API_KEY=

# Output language: en | ja (default: en)
# STYLECT_OUTPUT_LANG=en

# Colon-separated local repo search roots for --source auto/local
# REPO_SEARCH_PATHS=/path/to/repos
